<?xml version="1.0" encoding="UTF-8"?>

<!-- Maven configuration for the Enhancement One project -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the Maven project model -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Basic information used to identify the project -->
    <groupId>org.example</groupId>
    <artifactId>EnhancementOne</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>

        <!-- Use Java 17 when compiling the project -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Use UTF-8 when reading project files -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    <dependencies>

        <!-- JUnit 5 is used for the unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <!-- Allows Maven to find and run the JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>

    </build>

</project>